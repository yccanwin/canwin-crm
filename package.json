{
  "name": "canwin-crm",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "CanWin internal CRM monorepo",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "npm --workspace @canwin-crm/web run dev",
    "build": "npm --workspace @canwin-crm/web run build",
    "lint": "npm --workspace @canwin-crm/web run lint",
    "test": "npm --workspace @canwin-crm/web run test",
    "typecheck": "npm --workspace @canwin-crm/web run typecheck",
    "verify:scaffold": "node scripts/verify-scaffold.mjs",
    "verify:env": "node scripts/verify-env-boundary.mjs",
    "verify:quality-config": "node scripts/verify-quality-config.mjs",
    "verify:supabase": "node scripts/verify-supabase-baseline.mjs",
    "verify:auth": "node scripts/verify-auth-contract.mjs",
    "verify:observability": "node scripts/verify-observability-contract.mjs",
    "verify:shared-archive": "node scripts/verify-shared-archive-contract.mjs",
    "verify:contacts": "node scripts/verify-contact-contract.mjs",
    "verify:portraits": "node scripts/verify-portrait-contract.mjs",
    "verify:ci-credential-suppression": "node scripts/verify-ci-credential-suppression.mjs",
    "verify:auth:runtime": "node scripts/verify-auth-runtime.mjs",
    "verify:contacts:runtime": "node scripts/verify-contact-access-runtime.mjs",
    "verify:portraits:runtime": "node scripts/verify-portrait-runtime.mjs",
    "verify:portraits:scale": "node scripts/verify-portrait-scale.mjs",
    "verify:portraits:geometry": "node scripts/verify-portrait-mobile-geometry.mjs",
    "verify:observability:runtime": "node scripts/verify-observability-runtime.mjs",
    "prove:quality-gates": "node scripts/prove-quality-gate-failures.mjs",
    "check": "npm run verify:scaffold && npm run verify:env && npm run verify:quality-config && npm run verify:supabase && npm run verify:auth && npm run verify:observability && npm run verify:shared-archive && npm run verify:contacts && npm run verify:portraits && npm run verify:ci-credential-suppression && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "supabase": "2.114.0"
  }
}

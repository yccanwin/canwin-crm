# Placeholder contract only. Never commit a populated environment file.
# Copy to an ignored local file and use development-project values only.

CANWIN_ENV=<dev-test-or-prod>
SUPABASE_URL=<environment-specific-supabase-project-url>

# Edge Functions expose new API keys as JSON dictionaries keyed by key name.
# These placeholders intentionally contain no runnable key material.
SUPABASE_PUBLISHABLE_KEYS=<json-map-of-key-name-to-sb_publishable-placeholder>
SUPABASE_SECRET_KEYS=<json-map-of-key-name-to-sb_secret-placeholder>

# Legacy SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are intentionally absent.
# They are migration-only compatibility variables, not defaults for new code.
